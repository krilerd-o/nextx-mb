# Copy this file to ".env" in the same folder as docker-compose.yml
# Docker Compose automatically loads .env for variable substitution.
#
# PostgreSQL is published on the HOST at PG_PORT (inside the container it stays 5432).
PG_PORT=15433
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=db_moai_next

# MongoDB host port (container stays 27017)
MONGO_PORT=27017
