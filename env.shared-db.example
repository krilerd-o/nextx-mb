# Copy to env.shared-db (same folder). run-shared-db.cmd จะสร้างให้ถ้ายังไม่มี
# NEXTX_NETWORK ถูกตั้งอัตโนมัติจาก container moai-next-pg เมื่อรัน run-shared-db.ps1
# ถ้า detect ไม่ได้ ให้แก้เองให้ตรงกับ: docker network ls

# ชื่อจริงมักเป็น nextx_default (ดู docker network ls) — ไม่ใช่ NEXTX_default
NEXTX_NETWORK=nextx_default

# โปรเจกต์ NEXTX (MOAI NEXT Web) ใช้ชื่อ service นี้ใน docker-compose.yml
NEXTX_PG_HOST=postgres

# ตรงกับ backend เว็บ: mongodb://mongo:27017/moai_next (ชื่อ service คือ mongo ไม่ใช่ mongodb)
NEXTX_MONGO_URI=mongodb://mongo:27017

PG_DATABASE=db_moai_next
PG_USER=postgres
PG_PASSWORD=postgres
MONGO_DB=moai_next

# พอร์ตโฮสต์ของ Mobile API (ถ้าชนกับ container อื่น เปลี่ยนเป็น 4001 แล้ว build web ใหม่)
PORT_MB=4000
WEB_PORT_MB=8080
