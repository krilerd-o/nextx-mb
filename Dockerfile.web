# Stage 1: Build Flutter web
# API_BASE_URL = URL ที่เบราว์เซอร์เรียก API (แนะนำพอร์ตเดียวกับเว็บผ่าน nginx proxy — เช่น http://localhost:8080)
FROM ghcr.io/cirruslabs/flutter:stable AS builder
ARG API_BASE_URL=http://localhost:8080
WORKDIR /app

COPY pubspec.yaml ./
COPY lib/ lib/
COPY analysis_options.yaml ./
COPY assets/ assets/

RUN flutter pub get \
  && flutter create . --platforms web \
  && flutter build web --release --no-wasm-dry-run --dart-define=API_BASE_URL=${API_BASE_URL}

# Stage 2: nginx + proxy /health /ready /api → Mobile API container
FROM nginx:alpine
COPY --from=builder /app/build/web /usr/share/nginx/html
ARG BACKEND_HOST=moai-next-api-mb
COPY docker/nginx-web-proxy.template.conf /tmp/default.conf.tpl
RUN sed "s/BACKEND_HOST/${BACKEND_HOST}/g" /tmp/default.conf.tpl > /etc/nginx/conf.d/default.conf \
  && rm /tmp/default.conf.tpl
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
