# ค่าแนะนำสำหรับ ~1,000 คน — copy ไปรวมกับ .env (หรือ copy ทับส่วนที่เกี่ยวข้อง)
# ดู SCALING.md สำหรับรายละเอียด

PORT=4000

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=db_moai_next
PG_USER=postgres
PG_PASSWORD=postgres
PG_POOL_SIZE=50

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=nextx
MONGO_COLLECTION=example
MONGO_POOL_SIZE=100

# Rate limit (ครั้ง/นาที ต่อ IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PER_IP=300

# Request timeout (ms)
REQUEST_TIMEOUT_MS=30000
