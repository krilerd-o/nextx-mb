# Copy to .env and set values (Mobile API แยก แต่ใช้ DB เดียวกับ Web)
# รองรับทั้ง DB_* / PG_* / MONGODB_*
PORT=4000

# URL ที่แอป Android เรียก (ใช้ตอน build APK — build-apk.cmd อ่านอัตโนมัติ)
# บนมือถือจริง: IP ของ PC ที่รัน API (เช่น http://192.168.1.5:4000) — ห้ามใช้ localhost
# บน Android Emulator: http://10.0.2.2:4000 ชี้ไปที่ localhost ของเครื่อง host
MOBILE_API_BASE_URL=http://192.168.1.100:4000

# PostgreSQL (ค่าแนะนำตาม Docker ที่กำหนด)
DB_HOST=127.0.0.1
DB_PORT=15433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=db_moai_next
# DB_CONNECT_TIMEOUT=60000
# DB_POOL_SIZE=1

PG_HOST=127.0.0.1
PG_PORT=15433
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=db_moai_next

# รองรับหลักพันคน: ใช้ PG_POOL_SIZE สูงกว่า DB_POOL_SIZE (default 50)
# PG_POOL_SIZE=50

# MongoDB
MONGODB_URI=mongodb://localhost:27017/moai_next
MONGODB_DB_NAME=moai_next

# backward-compatible aliases
MONGO_URI=mongodb://localhost:27017/moai_next
MONGO_DB=moai_next
MONGO_COLLECTION=example
# รองรับหลักพันคน: default 100
# MONGO_POOL_SIZE=100

# Rate limit ต่อ IP (default 300 ครั้ง/นาที). ปรับตามจำนวน user
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_PER_IP=300

# Request timeout (ms). default 30000
# REQUEST_TIMEOUT_MS=30000

# Security baseline (OAuth2 external IdP + transition)
# ใส่ issuer/audience/jwks จากผู้ให้บริการ OAuth2 (Auth0/Cognito/Keycloak ฯลฯ)
OAUTH_ISSUER=
OAUTH_AUDIENCE=
OAUTH_JWKS_URI=
OAUTH_TOKEN_ENDPOINT=
OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=

# Transition mode: true = ยอมรับ X-User-Id/X-Business-Id ชั่วคราว (ไม่ปลอดภัย — เปิดเฉพาะ dev)
AUTH_TRANSITION_MODE=false
# กำหนดวันปิด legacy context (ตัวอย่าง)
AUTH_TRANSITION_DEADLINE=2026-12-31

# CORS allowlist (comma-separated), ว่าง = อนุญาตทุก origin (dev only)
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8080

# Scope model: simple + ready for granular mapping
# SIMPLE_SCOPE_ENTITY_WRITE=entity:write
